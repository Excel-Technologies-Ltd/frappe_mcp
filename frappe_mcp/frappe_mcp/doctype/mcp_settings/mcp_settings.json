   "fieldname": "general_tab",
   "fieldtype": "Tab Break",
   "label": "General"
  },
  {
   "default": "0",
   "description": "Master switch for the in-desk assistant. MCP connectors keep working when this is off.",
   "fieldname": "enable_ai_assistant",
   "fieldtype": "Check",
   "label": "Enable AI Assistant"
  },
  {
   "default": "1",
   "description": "Store each assistant question, the answer, DocTypes touched, and duration. Document field dumps are not given their own columns.",
   "fieldname": "enable_query_logging",
   "fieldtype": "Check",
   "label": "Enable Query Logging"
  },
  {
   "default": "1",
   "description": "Let tools search and run this site's Query and Script Reports through Frappe's report engine.",
   "fieldname": "enable_reports_tool",
   "fieldtype": "Check",
   "label": "Enable Reports Tool"
  },
  {
   "default": "1",
