  },
  {
   "fieldname": "connection_note",
   "fieldtype": "HTML",
   "options": "<div class='text-muted small'>Each user creates an MCP Connector and receives a token. Clients POST JSON-RPC to <b>/mcp</b> with <code>Authorization: Bearer &lt;token&gt;</code>. The connector runs as that user. Create, Read, and Update are on unless you turn them off. Cancel and Delete run only when both this page and the connector allow them.</div>"
  }
